# ==========================================
# Backend Environment Variables
# ==========================================

# Core Settings
APP_ENV=development
FRONTEND_URL=http://localhost:3000

# Database & Cache
# PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://user:password@localhost/shieldcheck
# Redis connection string (for Celery and caching)
REDIS_URL=redis://localhost:6379/0

# Security
# Secret used for signing JWTs
JWT_SECRET=your_super_secret_jwt_key_here

# Limits
MAX_SCANS_PER_IP_PER_HOUR=10
SCAN_CACHE_HOURS=24

# AI Providers (At least one is recommended for AI Translator feature)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Payments (Razorpay)
RAZORPAY_KEY_ID=rzp_test_example123
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Email (Resend)
RESEND_API_KEY=
FROM_EMAIL=reports@shieldcheck.com

# Integrations / Scanners (Optional but highly recommended)
SHODAN_API_KEY=
WPSCAN_API_TOKEN=
HIBP_API_KEY=
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_KEY=
URLSCAN_API_KEY=
LEAKIX_API_KEY=
ABUSEIPDB_API_KEY=

# Monitoring (Optional)
SENTRY_DSN=