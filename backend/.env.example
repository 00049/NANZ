APP_ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:localdev@localhost:5432/shieldcheck
REDIS_URL=redis://localhost:6379
JWT_SECRET=change_this_to_64_char_random_hex
APP_SECRET_KEY=change_this_to_64_char_random_hex

# ── Existing API keys ──
SHODAN_API_KEY=
HIBP_API_KEY=
ANTHROPIC_API_KEY=dummy
RAZORPAY_KEY_ID=dummy
RAZORPAY_KEY_SECRET=dummy
RESEND_API_KEY=dummy
FROM_EMAIL=reports@shieldcheck.in

# ── Rate limiting ──
MAX_SCANS_PER_IP_PER_HOUR=5
SCAN_CACHE_HOURS=6

# ── Observability ──
SENTRY_DSN=

# ── Expanded scan engine API keys ──
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_KEY=
URLSCAN_API_KEY=
LEAKIX_API_KEY=
WPSCAN_API_TOKEN=
ABUSEIPDB_API_KEY=
NUCLEI_TEMPLATES_PATH=/opt/nuclei-templates